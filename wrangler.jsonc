{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helpgate",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "helpgate.in",
      "custom_domain": true
    },
    {
      "pattern": "www.helpgate.in",
      "custom_domain": true
    }
  ]
}
